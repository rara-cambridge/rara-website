{
  "version": 8,
  "name": "Hand Drawn Cartoon Style",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://api.maptiler.com/tiles/v3/tiles.json?key=zsAKnM69p5uDhfEeaTCu"
    }
  },
  "glyphs": "https://api.maptiler.com/fonts/caveat,patrick-hand/{fontstack}/{range}.pbf?key=zsAKnM69p5uDhfEeaTCu",
  "sprite": "https://api.maptiler.com/maps/streets/sprite",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f6f1e1"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#9fd3ff",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "water-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "line-color": "#4a90c2",
        "line-width": 2,
        "line-opacity": 0.4
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#d7e8b5",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#bfe8a3",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#e6f2c6",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "roads-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#2b2b2b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 10, 2, 14, 5, 18, 10],
        "line-opacity": 0.25,
        "line-blur": 0.3
      }
    },
    {
      "id": "roads-fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.6, 10, 1.5, 14, 3.5, 18, 7],
        "line-opacity": 1,
        "line-blur": 0.2
      }
    },
    {
      "id": "major-roads-highlight",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary", "tertiary"],
      "paint": {
        "line-color": "#ffd36b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 10, 2.5, 14, 6, 18, 12],
        "line-opacity": 0.75,
        "line-blur": 0.6
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#f2d7b3",
        "fill-outline-color": "#6b5b45",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "buildings-shadow",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#cbb08b",
        "fill-opacity": 0.25,
        "fill-translate": [2, 2]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "layout": {
        "text-field": "{name}",
        "text-size": 12,
        "text-font": ["Open Sans Regular"],
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#3a3a3a",
        "text-halo-color": "#fff7d6",
        "text-halo-width": 2
      }
    }
  ],
  "id": "min6h6x"
}
